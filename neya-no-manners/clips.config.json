    { "text": "That's just how I move these days 😎", "start": 145.48, "end": 149.20 },
    { "text": "You see me? Keep walking 🚶‍♀️", "start": 150.34, "end": 153.52 },
    { "text": "Baby, I'm the reason they still can't sleep 🌙", "start": 153.52, "end": 156.84 },
    { "text": "Every promise that I keep, I keep 🤝", "start": 156.84, "end": 158.80 },
    { "text": "Every threat I make, I follow through 😈", "start": 158.80, "end": 160.70 },
    { "text": "That's the difference between me and you ⚡", "start": 160.70, "end": 162.62 },
    { "text": "I don't play, I don't pretend 🎭", "start": 162.62, "end": 164.52 },
    { "text": "I don't do the on and off again 🔁", "start": 164.52, "end": 166.42 },
    { "text": "Once you're out, you're out for good 🔒", "start": 166.42, "end": 168.36 },
