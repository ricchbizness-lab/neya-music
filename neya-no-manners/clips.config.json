  "lyrics": [
    { "text": "Closer 😏", "start": 2.00, "end": 4.28 },
    { "text": "Not yet ⏳", "start": 4.28, "end": 6.18 },
    { "text": "They said Neya changed, I said correct 💅", "start": 12.56, "end": 16.22 },
    { "text": "Cut off everybody who wouldn't respect 🚫", "start": 16.22, "end": 19.96 },
    { "text": "The version of me that I fought hard to become ✨", "start": 19.96, "end": 23.88 },
    { "text": "Now they miss me, now they numb 🖤", "start": 23.88, "end": 27.50 },
    { "text": "You lost access when you played your part 🔒", "start": 27.50, "end": 30.82 },
    { "text": "Broken glass don't reassemble the heart 💔", "start": 31.50, "end": 34.54 },
    { "text": "Don't come knocking on this door no more 🚪", "start": 35.50, "end": 38.18 },
    { "text": "That's exactly what the block is for 📵", "start": 39.50, "end": 42.24 },
    { "text": "I don't do second chances anymore ⛔", "start": 43.50, "end": 46.86 },
    { "text": "Learned my lesson from the ones before 📖", "start": 47.50, "end": 50.52 },
    { "text": "Loyalty is rare and mine is worth 👑", "start": 50.52, "end": 54.04 },
    { "text": "More than everything you had on Earth 🌍", "start": 54.04, "end": 58.68 },
    { "text": "No manners, no manners 💅", "start": 58.68, "end": 60.64 },
    { "text": "I don't owe you no manners 🚫", "start": 62.04, "end": 65.14 },
    { "text": "No manners, no manners 💅", "start": 66.04, "end": 68.64 },
    { "text": "Cut you off with no manners ✂️", "start": 68.64, "end": 72.68 },
    { "text": "Watch me walk right past your face 😤", "start": 72.68, "end": 76.00 },
    { "text": "Like you're taking up my space 🚶‍♀️", "start": 77.04, "end": 79.62 },
    { "text": "No manners, no manners 💅", "start": 81.36, "end": 83.98 },
    { "text": "That's just how I move these days 😎", "start": 83.98, "end": 87.26 },
    { "text": "They been talking, tell them keep my name 🗣️", "start": 89.24, "end": 92.02 },
    { "text": "Every whisper only adds to my fame ✨", "start": 92.02, "end": 93.80 },
    { "text": "I don't respond, I don't reply 🙅‍♀️", "start": 93.80, "end": 95.82 },
    { "text": "Silence louder than the loudest cry 🤐", "start": 95.82, "end": 97.58 },
    { "text": "Kept my circle small for a reason ⭕", "start": 97.58, "end": 99.48 },
    { "text": "Trust nobody, not even the season ❄️", "start": 99.48, "end": 101.40 },
    { "text": "Winter came and showed me who's who 🥶", "start": 101.40, "end": 103.56 },
    { "text": "Baby, that's what winter does to you 🧊", "start": 103.56, "end": 104.98 },
    { "text": "I don't do second chances anymore ⛔", "start": 104.98, "end": 107.72 },
