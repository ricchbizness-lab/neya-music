  "lyrics": [
    { "text": "Closer 😏", "start": 0.00, "end": 2.14 },
    { "text": "Not yet ⏳", "start": 3.00, "end": 5.00 },
    { "text": "Yeah... 🎶", "start": 7.52, "end": 8.92 },
    { "text": "This is the aftermath 💥", "start": 9.92, "end": 12.20 },
    { "text": "Used to break easy, used to bend the knee 😤", "start": 18.54, "end": 21.76 },
    { "text": "Every storm I survived made a stronger me 🔥", "start": 21.76, "end": 25.40 },
    { "text": "Ashes on the ground where the old me used to stand 🔥", "start": 25.40, "end": 28.96 },
    { "text": "Now I'm the reason they don't understand 🤷‍♀️", "start": 28.96, "end": 31.86 },
    { "text": "Vai! 🔥", "start": 31.86, "end": 32.88 },
    { "text": "Look closer 👀", "start": 33.26, "end": 34.50 },
    { "text": "I don't warn you twice, I just move 💅", "start": 34.50, "end": 36.56 },
    { "text": "Everything I touch, I improve ✨", "start": 38.12, "end": 41.52 },
    { "text": "You were standing here before the wave 🌊", "start": 41.52, "end": 44.46 },
    { "text": "Now you're counting what you couldn't save 💔", "start": 44.46, "end": 48.86 },
    { "text": "Aftermath, aftermath 💥", "start": 48.86, "end": 51.66 },
    { "text": "Baby, you don't wanna feel my wrath 😈", "start": 51.66, "end": 56.34 },
    { "text": "Aftermath, aftermath 💥", "start": 56.34, "end": 59.06 },
    { "text": "I leave nothing in my path 🚶‍♀️", "start": 59.06, "end": 63.60 },
    { "text": "Built from fire, built from pain 🔥", "start": 63.60, "end": 65.56 },
    { "text": "Every scar became my chain 🔗", "start": 65.56, "end": 67.46 },
    { "text": "Aftermath, aftermath 💥", "start": 67.46, "end": 70.14 },
    { "text": "Neya never looks back again 👑", "start": 70.14, "end": 75.56 },
    { "text": "Watch, watch close 👀", "start": 75.56, "end": 78.50 },
    { "text": "They wonder how I stay this cold 🥶", "start": 78.50, "end": 81.56 },
    { "text": "Simple — I already lost it all 🖤", "start": 81.58, "end": 85.36 },
    { "text": "Nothing left for me to fear 😌", "start": 85.36, "end": 88.18 },
    { "text": "That's why nobody moves me here 🚫", "start": 88.18, "end": 92.12 },
    { "text": "Feel that coming? Too late now ⏳", "start": 92.12, "end": 95.14 },
    { "text": "Aftermath, aftermath 💥", "start": 95.14, "end": 97.80 },
    { "text": "Baby, you don't wanna feel my wrath 😈", "start": 97.80, "end": 102.48 },
    { "text": "Aftermath, aftermath 💥", "start": 102.48, "end": 104.60 },
    { "text": "I leave nothing in my path 🚶‍♀️", "start": 104.60, "end": 109.88 },
    { "text": "Let's go! 🙌", "start": 109.88, "end": 111.60 },
    { "text": "Aftermath, aftermath 💥", "start": 116.60, "end": 119.40 },
    { "text": "Baby, you don't wanna feel my wrath 😈", "start": 119.40, "end": 128.34 },
