    { "text": "Built from fire, built from pain 🔥", "start": 135.66, "end": 137.56 },
    { "text": "Every loss became my gain 💰", "start": 137.56, "end": 139.34 },
    { "text": "This ain't ever gonna stop 🚫", "start": 139.34, "end": 141.20 },
    { "text": "Neya standing at the top 👑", "start": 141.20, "end": 143.10 },
    { "text": "Aftermath, aftermath 💥", "start": 143.10, "end": 145.74 },
